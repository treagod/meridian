[Unit]
Description=<%= @description %>
<% unless @accessory_units.empty? %>
Wants=<%= @accessory_units.join(" ") %>
After=<%= @accessory_units.join(" ") %>
<% end %>

[Container]
Image=<%= @image %>
ContainerName=<%= @name %>
<% @networks.each do |network| %>
Network=<%= network %>
<% end %>
<% @environment.each do |key, value| %>
Environment=<%= key %>=<%= value %>
<% end %>
<% @secrets.each do |secret| %>
Secret=<%= secret %>
<% end %>
<% @volumes.each do |volume| %>
Volume=<%= volume %>
<% end %>
<% @ports.each do |port| %>
PublishPort=<%= port %>
<% end %>
<% if command = @command %>
Exec=<%= command %>
<% end %>
# StopTimeout= needs Podman 5.0; PodmanArgs passes the same flag on 4.9.
PodmanArgs=--stop-timeout=<%= @stop_timeout %>

[Service]
Restart=always
TimeoutStopSec=<%= @stop_timeout.to_i64 + Generator::STOP_TIMEOUT_MARGIN %>

[Install]
WantedBy=default.target
