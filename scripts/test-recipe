#!/usr/bin/env bash
set -euo pipefail

RECIPE="${1:-}"

case "$RECIPE" in
  marten-sqlite-assets)
    SERVICE="meridian-e2e"
    FIXTURE_NAME="marten-sqlite-assets"
    VM_SUFFIX="marten"
    IMAGE="localhost/meridian-e2e-marten:latest"
    APP_HOST="e2e-app.test"
    ASSET_HOST="e2e-assets.test"
    ASSET_HREF_PATTERN="css\\/app"
    HEALTH_PATH="/health"
    HEALTH_BODY_PATTERN="^ok$"
    DATA_STORE_LABEL="SQLite"
    SUCCESS_LABEL="Marten SQLite recipe E2E"
    ACCESSORIES=()
    SECRETS=("MARTEN_SECRET_KEY=e2e-secret-key-that-is-long-enough-for-marten")
    # Deploys two distinctly tagged releases and verifies `meridian rollback`
    # reconstructs and serves the first one again.
    ROLLBACK_LEG=1
    ;;
  marten-postgres-dragonfly-assets)
    SERVICE="meridian-e2e-marten-pg"
    FIXTURE_NAME="marten-postgres-dragonfly-assets"
    VM_SUFFIX="marten-pg"
    IMAGE="localhost/meridian-e2e-marten-pg:latest"
    APP_HOST="e2e-pg-app.test"
    ASSET_HOST="e2e-pg-assets.test"
    ASSET_HREF_PATTERN="css\\/app"
    HEALTH_PATH="/healthz"
    HEALTH_BODY_PATTERN="^ok$"
    DATA_STORE_LABEL="Postgres"
    SUCCESS_LABEL="Marten Postgres Dragonfly recipe E2E"
    ACCESSORIES=("${SERVICE}-postgres" "${SERVICE}-dragonfly")
    SECRETS=(
      "MARTEN_SECRET_KEY=e2e-secret-key-that-is-long-enough-for-marten"
      "MY_APP_DATABASE_PASSWORD=e2e-postgres-password"
    )
    ROLLBACK_LEG=0
    ;;
  rails-postgres)
    SERVICE="meridian-e2e-rails"
    FIXTURE_NAME="rails-postgres"
    VM_SUFFIX="rails"
    IMAGE="localhost/meridian-e2e-rails:latest"
    APP_HOST="e2e-rails-app.test"
    # The Rails recipe serves precompiled assets from the app container.
    ASSET_HOST=""
    ASSET_HREF_PATTERN="assets\\/app"
    HEALTH_PATH="/up"
    HEALTH_BODY_PATTERN="background-color: green"
    DATA_STORE_LABEL="Postgres"
    SUCCESS_LABEL="Rails Postgres recipe E2E"
    ACCESSORIES=("${SERVICE}-postgres")
    SECRETS=(
      "MY_APP_SECRET_KEY_BASE=e2e-secret-key-base-that-is-long-enough"
      "MY_APP_DATABASE_PASSWORD=e2e-postgres-password"
    )
    ROLLBACK_LEG=0
    ;;
  *)
    echo "Usage: scripts/test-recipe marten-sqlite-assets|marten-postgres-dragonfly-assets|rails-postgres" >&2
  exit 64
    ;;
esac

# The rollback leg needs two distinguishable releases: unique per-release tags
# keep the first image alive across the second deploy's dangling-image prune.
if [[ "$ROLLBACK_LEG" == "1" ]]; then
  IMAGE_REPO="${IMAGE%:*}"
  IMAGE="$IMAGE_REPO:release-a"
  IMAGE_B="$IMAGE_REPO:release-b"
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FIXTURE_DIR="$ROOT_DIR/e2e/fixtures/$FIXTURE_NAME"
LIMA_TEMPLATE="$ROOT_DIR/e2e/lima/ubuntu-24.04.yaml"
VM_NAME="${MERIDIAN_E2E_VM_NAME:-meridian-e2e-${VM_SUFFIX}-$$}"
ROOT_PASSWORD="meridian-e2e"
KEEP_VM="${KEEP_VM:-0}"
WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/meridian-e2e.XXXXXX")"
APP_DIR="$WORK_DIR/app"
LOG_DIR="$WORK_DIR/logs"
KEY_FILE="$WORK_DIR/id_ed25519"
KNOWN_HOSTS_FILE="$WORK_DIR/known_hosts"
WRAPPER_DIR="$WORK_DIR/bin"
MERIDIAN_BIN="$ROOT_DIR/bin/meridian"
VM_CREATED=0
VM_IP=""

mkdir -p "$LOG_DIR" "$WRAPPER_DIR"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 69
  fi
}

for command in crystal curl expect limactl nc podman ssh-keygen; do
  require_command "$command"
done

REAL_SSH="$(command -v ssh)"
REAL_SCP="$(command -v scp)"

cat >"$WRAPPER_DIR/ssh" <<EOF
#!/usr/bin/env bash
exec "$REAL_SSH" -o UserKnownHostsFile="$KNOWN_HOSTS_FILE" "\$@"
EOF

cat >"$WRAPPER_DIR/scp" <<EOF
#!/usr/bin/env bash
exec "$REAL_SCP" -o UserKnownHostsFile="$KNOWN_HOSTS_FILE" "\$@"
EOF

chmod +x "$WRAPPER_DIR/ssh" "$WRAPPER_DIR/scp"

log_step() {
  printf '\n==> %s\n' "$1"
}

run_logged() {
  local name="$1"
  shift
  "$@" 2>&1 | tee "$LOG_DIR/$name.log"
}

ssh_deploy() {
  PATH="$WRAPPER_DIR:$PATH" ssh \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -i "$KEY_FILE" \
    "deploy@$VM_IP" \
    "$@"
}

wait_for_accessory_ready() {
  local accessory="$1"

  case "$accessory" in
    *-postgres)
      ssh_deploy "for i in \$(seq 1 60); do podman exec '$accessory' pg_isready -q && exit 0; sleep 1; done; exit 1"
      ;;
    *-dragonfly)
      ssh_deploy "podman run --rm --network='$SERVICE' docker.io/library/alpine:3.21 sh -c 'for i in \$(seq 1 60); do nc -z \"$accessory\" 6379 && exit 0; sleep 1; done; exit 1'"
      ;;
  esac
}

render_deploy_config() {
  sed \
    -e "s|__HOST__|$VM_IP|g" \
    -e "s|__SSH_KEY__|$KEY_FILE|g" \
    -e "s|__IMAGE__|$1|g" \
    "$APP_DIR/.meridian/deploy.yml.template" >"$APP_DIR/.meridian/deploy.yml"
}

assert_release_marker() {
  local expected="$1"
  local body
  body="$(
    curl --fail --silent --show-error \
      --resolve "$APP_HOST:80:$VM_IP" \
      "http://$APP_HOST/release"
  )"
  if [[ "$body" != "$expected" ]]; then
    echo "Expected release marker '$expected' but got '$body'" >&2
    return 1
  fi
}

# The same rootless network re-sync stall can hit kamal-proxy's own 30s deploy
# health window: the freshly started candidate is verifiably healthy (Meridian's
# sidecar probes pass) but requests from the long-running proxy container never
# reach it until the stall clears. A failed candidate is fully cleaned up, so
# re-running the switch is idempotent; retry once when the log shows exactly
# that kamal-proxy timeout.
run_switch_with_retry() {
  local name="$1"
  shift
  if run_logged "$name" "$@"; then
    return 0
  fi
  if grep -q "target failed to become healthy within configured timeout" "$LOG_DIR/$name.log"; then
    echo "kamal-proxy switch hit the rootless network re-sync stall; retrying once" >&2
    sleep 20
    run_logged "${name}-retry" "$@"
    return $?
  fi
  return 1
}

# Removing the old colour's container right after the proxy switch can stall
# the rootless Podman network for a few seconds (aardvark-dns re-syncs), so the
# first request after a redeploy gets a bounded retry window before the strict
# single-shot assertions run.
wait_for_app_health() {
  for _ in $(seq 1 10); do
    if curl --fail --silent --max-time 15 \
      --resolve "$APP_HOST:80:$VM_IP" \
      "http://$APP_HOST$HEALTH_PATH" | grep -q "$HEALTH_BODY_PATTERN"; then
      return 0
    fi
    sleep 2
  done

  echo "Application health check never passed at http://$APP_HOST$HEALTH_PATH" >&2
  return 1
}

collect_diagnostics() {
  [[ -n "$VM_IP" && -f "$KEY_FILE" ]] || return 0

  {
    echo "== systemd units =="
    ssh_deploy "systemctl --user --no-pager --full status 'meridian-e2e-*' kamal-proxy.service" || true
    echo
    echo "== containers =="
    ssh_deploy "podman ps -a" || true
    echo
    echo "== recent user journal =="
    ssh_deploy "journalctl --user --no-pager -n 400" || true
  } >"$LOG_DIR/diagnostics.log" 2>&1
}

cleanup() {
  local status=$?
  trap - EXIT

  if [[ $status -ne 0 ]]; then
    collect_diagnostics
    echo
    echo "E2E test failed. Logs: $LOG_DIR" >&2
  fi

  if [[ $VM_CREATED -eq 1 && "$KEEP_VM" != "1" ]]; then
    limactl delete --force "$VM_NAME" >/dev/null 2>&1 || true
  elif [[ $VM_CREATED -eq 1 ]]; then
    echo "Keeping Lima VM: $VM_NAME"
  fi

  if [[ $status -eq 0 && "$KEEP_VM" != "1" ]]; then
    rm -rf "$WORK_DIR"
  else
    echo "Keeping work directory: $WORK_DIR"
  fi

  exit "$status"
}
trap cleanup EXIT

log_step "Preparing $RECIPE fixture"
cp -R "$FIXTURE_DIR" "$APP_DIR"
ssh-keygen -q -t ed25519 -N "" -f "$KEY_FILE"

log_step "Starting Ubuntu 24.04 Lima VM"
run_logged lima-start limactl start --name "$VM_NAME" --tty=false "$LIMA_TEMPLATE"
VM_CREATED=1

log_step "Discovering VM IP"
VM_IP_FILE="$WORK_DIR/vm-ip-candidates"
limactl shell "$VM_NAME" -- sh -lc \
  "ip -4 -o address show scope global | awk '{split(\$4, address, \"/\"); print address[1]}'" \
  >"$VM_IP_FILE" &
VM_IP_PID=$!
for _ in {1..60}; do
  if ! kill -0 "$VM_IP_PID" >/dev/null 2>&1; then
    wait "$VM_IP_PID"
    break
  fi
  sleep 1
done
if kill -0 "$VM_IP_PID" >/dev/null 2>&1; then
  kill "$VM_IP_PID" >/dev/null 2>&1 || true
  wait "$VM_IP_PID" >/dev/null 2>&1 || true
  echo "Timed out while discovering the Lima VM IP" >&2
  exit 70
fi
VM_IP_CANDIDATES="$(cat "$VM_IP_FILE")"

while IFS= read -r candidate; do
  if nc -z -w 2 "$candidate" 22 >/dev/null 2>&1; then
    VM_IP="$candidate"
    break
  fi
done <<<"$VM_IP_CANDIDATES"

if [[ -z "$VM_IP" ]]; then
  echo "Could not find a host-reachable Lima VM address" >&2
  exit 70
fi

render_deploy_config "$IMAGE"

log_step "Building Meridian"
run_logged meridian-build crystal build "$ROOT_DIR/src/meridian_cli.cr" -o "$MERIDIAN_BIN"

log_step "Building $RECIPE image"
if [[ "$ROLLBACK_LEG" == "1" ]]; then
  run_logged image-build podman build --build-arg RELEASE_MARKER=release-a -t "$IMAGE" "$APP_DIR"
else
  run_logged image-build podman build -t "$IMAGE" "$APP_DIR"
fi

log_step "Bootstrapping the VM"
PATH="$WRAPPER_DIR:$PATH" expect <<EOF 2>&1 | tee "$LOG_DIR/bootstrap.log"
set timeout 2400
spawn "$MERIDIAN_BIN" server bootstrap \
  --host "$VM_IP" \
  --root-user root \
  --deploy-user deploy \
  --enable-auto-updates no \
  --config "$APP_DIR/.meridian/deploy.yml"
expect {
  -re "(?i)password:" {
    send "$ROOT_PASSWORD\r"
    exp_continue
  }
  eof
}
set result [wait]
exit [lindex \$result 3]
EOF

for secret_pair in "${SECRETS[@]}"; do
  secret_name="${secret_pair%%=*}"
  secret_value="${secret_pair#*=}"
  log_step "Creating runtime secret $secret_name"
  run_logged "secret-${secret_name}" \
    env PATH="$WRAPPER_DIR:$PATH" \
    "$MERIDIAN_BIN" secret set "$secret_name" \
    --value "$secret_value" \
    --config "$APP_DIR/.meridian/deploy.yml"
done

log_step "Installing the shared proxy"
run_logged setup \
  env PATH="$WRAPPER_DIR:$PATH" \
  "$MERIDIAN_BIN" setup --config "$APP_DIR/.meridian/deploy.yml"

log_step "Pre-pulling the pinned health probe image"
run_logged probe-image \
  ssh_deploy "podman pull docker.io/library/alpine:3.21"

if ((${#ACCESSORIES[@]} > 0)); then
  for accessory in "${ACCESSORIES[@]}"; do
    log_step "Starting accessory $accessory"
    run_logged "accessory-${accessory}" \
      env PATH="$WRAPPER_DIR:$PATH" \
      "$MERIDIAN_BIN" accessory start "$accessory" \
      --config "$APP_DIR/.meridian/deploy.yml"

    log_step "Waiting for accessory $accessory"
    run_logged "accessory-ready-${accessory}" wait_for_accessory_ready "$accessory"
  done
fi

log_step "Checking the resolved plan and host"
run_logged plan "$MERIDIAN_BIN" plan --config "$APP_DIR/.meridian/deploy.yml"
run_logged check \
  env PATH="$WRAPPER_DIR:$PATH" \
  "$MERIDIAN_BIN" check --config "$APP_DIR/.meridian/deploy.yml"

log_step "Running first deploy"
run_switch_with_retry deploy-first \
  env PATH="$WRAPPER_DIR:$PATH" \
  "$MERIDIAN_BIN" deploy --config "$APP_DIR/.meridian/deploy.yml"

FIRST_COLOR="$(ssh_deploy "cat ~/.local/state/meridian/services/$SERVICE/active-color")"

log_step "Verifying application and fingerprinted asset"
HOME_HTML="$(
  curl --fail --silent --show-error \
    --resolve "$APP_HOST:80:$VM_IP" \
    "http://$APP_HOST/"
)"
grep -q "Meridian recipe E2E" <<<"$HOME_HTML"

ASSET_URL="$(
  sed -n "s/.*href=\"\([^\"]*${ASSET_HREF_PATTERN}[^\"]*\.css\)\".*/\1/p" <<<"$HOME_HTML" | head -n 1
)"
if [[ -z "$ASSET_URL" ]]; then
  echo "Application HTML did not contain a fingerprinted CSS URL" >&2
  exit 71
fi

ASSET_FETCH_HOST="${ASSET_HOST:-$APP_HOST}"
ASSET_PATH="${ASSET_URL#http://$ASSET_FETCH_HOST}"
ASSET_BODY="$(
  curl --fail --silent --show-error \
    --resolve "$ASSET_FETCH_HOST:80:$VM_IP" \
    "http://$ASSET_FETCH_HOST$ASSET_PATH"
)"
grep -q "meridian-e2e-marker" <<<"$ASSET_BODY"

log_step "Writing persistent $DATA_STORE_LABEL data"
RECORD_BODY="$(
  curl --fail --silent --show-error \
    --resolve "$APP_HOST:80:$VM_IP" \
    "http://$APP_HOST/records?value=survives-redeploy"
)"
grep -q "survives-redeploy" <<<"$RECORD_BODY"

if [[ "$RECIPE" == "marten-postgres-dragonfly-assets" ]]; then
  log_step "Writing persistent Dragonfly data"
  curl --fail --silent --show-error \
    --resolve "$APP_HOST:80:$VM_IP" \
    "http://$APP_HOST/dragonfly?value=dragonfly-survives" | grep -q "dragonfly-survives"
fi

if [[ "$ROLLBACK_LEG" == "1" ]]; then
  log_step "Verifying release marker for the first release"
  assert_release_marker "release-a"

  log_step "Building second release image"
  run_logged image-build-b podman build --build-arg RELEASE_MARKER=release-b -t "$IMAGE_B" "$APP_DIR"
  render_deploy_config "$IMAGE_B"
fi

sleep 2

log_step "Running second deploy"
run_switch_with_retry deploy-second \
  env PATH="$WRAPPER_DIR:$PATH" \
  "$MERIDIAN_BIN" deploy --config "$APP_DIR/.meridian/deploy.yml"

SECOND_COLOR="$(ssh_deploy "cat ~/.local/state/meridian/services/$SERVICE/active-color")"
if [[ "$FIRST_COLOR" == "$SECOND_COLOR" ]]; then
  echo "Expected the second deploy to switch color, but both used $FIRST_COLOR" >&2
  exit 72
fi

log_step "Verifying health, persistence, and assets after redeploy"
run_logged health-after-redeploy wait_for_app_health

curl --fail --silent --show-error \
  --resolve "$APP_HOST:80:$VM_IP" \
  "http://$APP_HOST/records" | grep -q "survives-redeploy"

if [[ "$RECIPE" == "marten-postgres-dragonfly-assets" ]]; then
  curl --fail --silent --show-error \
    --resolve "$APP_HOST:80:$VM_IP" \
    "http://$APP_HOST/dragonfly" | grep -q "dragonfly-survives"
fi

curl --fail --silent --show-error \
  --resolve "$ASSET_FETCH_HOST:80:$VM_IP" \
  "http://$ASSET_FETCH_HOST$ASSET_PATH" | grep -q "meridian-e2e-marker"

if [[ "$ROLLBACK_LEG" == "1" ]]; then
  log_step "Verifying release marker for the second release"
  assert_release_marker "release-b"

  log_step "Rolling back to the first release"
  run_switch_with_retry rollback \
    env PATH="$WRAPPER_DIR:$PATH" \
    "$MERIDIAN_BIN" rollback --config "$APP_DIR/.meridian/deploy.yml"

  ROLLBACK_COLOR="$(ssh_deploy "cat ~/.local/state/meridian/services/$SERVICE/active-color")"
  if [[ "$ROLLBACK_COLOR" != "$FIRST_COLOR" ]]; then
    echo "Expected rollback to restore color $FIRST_COLOR, but active color is $ROLLBACK_COLOR" >&2
    exit 73
  fi

  log_step "Verifying health and first-release content after rollback"
  run_logged health-after-rollback wait_for_app_health
  assert_release_marker "release-a"

  if ! ssh_deploy "grep -q ' | rollback | ' ~/.local/state/meridian/services/$SERVICE/audit.log"; then
    echo "Expected an audit log entry for the rollback" >&2
    exit 74
  fi
fi

echo
if [[ "$ROLLBACK_LEG" == "1" ]]; then
  echo "$SUCCESS_LABEL passed: $FIRST_COLOR -> $SECOND_COLOR -> rollback to $FIRST_COLOR"
else
  echo "$SUCCESS_LABEL passed: $FIRST_COLOR -> $SECOND_COLOR"
fi
